# Django settings
# Generate a new key with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY="your-local-secret-key-for-development"
DEBUG=True

# --- Option 1: Local Docker Database (Recommended for local development) ---
# Uncomment this line to connect to the local PostgreSQL DB from docker-compose.yml
DATABASE_URL="postgresql://tranche-autom-admin:a_strong_password_for_local_dev@127.0.0.1:5432/tranche_autom"

# --- Option 2: Cloud SQL Database (Requires VPN and network access) ---
# Uncomment this line to connect to the Cloud SQL instance via the proxy.
# Replace YOUR_DB_PASSWORD with the actual password from Secret Manager.
# DATABASE_URL="postgresql://tranche-autom-admin:YOUR_DB_PASSWORD@127.0.0.1:5432/tranche_autom"

# Okta settings for local development
OKTA_CLIENT_ID="your-local-okta-client-id"
OKTA_CLIENT_SECRET="your-local-okta-client-secret"
OKTA_ISSUER="your-local-okta-issuer-url"